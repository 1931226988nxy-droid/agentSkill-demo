{
  "name": "jcc-frontend-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @jcc/admin-demo",
    "dev:lab": "npm run dev -w @jcc/component-lab",
    "build": "npm run build -w @jcc/admin-demo && npm run build -w @jcc/component-lab",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "sync:skill": "node scripts/sync-skill.mjs",
    "check:skill": "node scripts/sync-skill.mjs --check",
    "quality": "npm run format:check && npm run check:skill && npm test && npm run build && npm run test:browser",
    "export:preview": "node scripts/export-preview.mjs",
    "format": "prettier --write \"packages/**/*.{js,vue,css,json,md}\" \"apps/*/**/*.{js,vue,css,json,html}\" \"tests/**/*.js\" \"scripts/*.mjs\" \"*.{js,json}\"",
    "format:check": "prettier --check \"packages/**/*.{js,vue,css,json,md}\" \"apps/*/**/*.{js,vue,css,json,html}\" \"tests/**/*.js\" \"scripts/*.mjs\" \"*.{js,json}\"",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "7.0.1",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.4.6",
    "ant-design-vue": "4.2.6",
    "jsdom": "26.1.0",
    "prettier": "^3.6.0",
    "vite": "8.3.5",
    "vitest": "^4.0.0",
    "vue": "3.5.44"
  }
}
